# Copy to .env and fill in the tag when Amazon Associates approves the site.
# Links earn nothing until this is a real tag such as sitename-20.
AMAZON_ASSOCIATE_TAG=

NICE_TOPIC=smart home IoT
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-8b-hermes:latest

# Optional. If this is set, drafts use OpenAI instead of the local model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
